# TEMPLATE. Install as /etc/systemd/system/itsec-report.service
[Unit]
Description=ITSec daily report (deterministic findings plus optional Claude narrative)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=itsec
Group=itsec
Environment=ITSEC_CONFIG=/etc/itsec/config.json
# claude keeps its own settings under HOME; both tokens arrive as credentials, never as arguments.
Environment=HOME=/var/lib/itsec/home
# the claude binary is root-installed (/usr/local/bin/claude); never let it replace itself
Environment=DISABLE_AUTOUPDATER=1
LoadCredential=paperclip-token:/etc/itsec/paperclip-token
LoadCredential=claude-token:/etc/itsec/claude-token
LoadCredential=idempotency-secret:/etc/itsec/idempotency-secret
ExecStart=/opt/itsec/bin/itsec-report
TimeoutStartSec=600
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/itsec
UMask=0077
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
StateDirectory=itsec itsec/home
StateDirectoryMode=0700
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# no MemoryDenyWriteExecute: the claude binary (V8/JIT) needs writable+executable memory
SystemCallFilter=@system-service
