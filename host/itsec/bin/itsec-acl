#!/usr/bin/python3 -I
"""itsec-acl: ADMIN step. install-watchdog.sh runs it (as root) to give the itsec account read access to one watched path of the
watched user's home, and to take that access away again on --uninstall. It never follows a symlink, not even in the middle of
the path (details and usage: itsec/acl.py).

  itsec-acl --uid 1000 grant  x /home/paperclip/.claude             traversal on a directory
  itsec-acl --uid 1000 grant  r /home/paperclip/.claude/settings.json
  itsec-acl --uid 1000 grant  R /home/paperclip/.claude/skills      read on a whole tree
  itsec-acl --uid 1000 remove R /home/paperclip/.claude/skills"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))
from itsec.acl import main      # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
