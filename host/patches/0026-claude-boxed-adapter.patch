+async function readClaudeCommandVersionForRun(input) {
+    if (!input.localProcessSandbox)
+        return readClaudeCommandVersion(input);
+    const version = await runAdapterExecutionTargetProcess(input.runId, input.target, input.command, ["--version"], {
+        cwd: input.cwd,
+        env: input.env,
