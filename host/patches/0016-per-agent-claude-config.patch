+// LOCAL-PATCH 0016: per-agent Claude config dir (mode 0700). Seeded once, only when settings.json is absent, with the
+// shared settings.json reduced to its "theme": that file was agent-writable until now, so hooks or other keys found
+// there are never propagated. Credentials, projects/, sessions/ and everything else are never copied.
+async function ensurePerAgentClaudeConfigDir(configDir, sharedConfigDir) {
+    await fs.mkdir(configDir, { recursive: true, mode: 0o700 });
+    await fs.chmod(path.dirname(configDir), 0o700);
+    await fs.chmod(configDir, 0o700);
+    const shared = await fs.readFile(path.join(sharedConfigDir, "settings.json"), "utf8").then((text) => JSON.parse(text), () => null);
+    const seed = shared && typeof shared === "object" && typeof shared.theme === "string" ? { theme: shared.theme } : {};
+    await fs.writeFile(path.join(configDir, "settings.json"), `${JSON.stringify(seed, null, 2)}\n`, { flag: "wx", mode: 0o600 }).catch((error) => {
+        if (error?.code !== "EEXIST")
+            throw error;
+    });
