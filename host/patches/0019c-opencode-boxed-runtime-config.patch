+// LOCAL-PATCH 0019c: a sandboxed agent's run (boxedRuntimeDir is its runtime dir, set by 0019) takes everything from the AGENT's env:
+// {env:NAME} placeholders of the provider config, the provider config itself and the small model never fall back to the server's
+// process.env (a config the agent controls could otherwise bake a server secret into the file the CLI reads). A placeholder with no
+// value in the agent's env is refused up front, before anything is created. The config copy is made in the runtime dir, which the box
+// mounts, instead of the system temp dir.
+const ENV_PLACEHOLDER = /\{env:([A-Za-z_][A-Za-z0-9_]*)\}/g;
+function assertBoxedProviderPlaceholders(env) {
+    const raw = env.PAPERCLIP_OPENCODE_PROVIDERS;
+    if (typeof raw !== "string")
+        return;
+    for (const match of raw.matchAll(ENV_PLACEHOLDER)) {
+        const value = env[match[1]];
+        if (typeof value !== "string" || value.length === 0) {
+            throw new Error(`PAPERCLIP_OPENCODE_PROVIDERS refers to {env:${match[1]}}, which is not set in this agent's own env. A sandboxed OpenCode agent never reads the server's environment: add ${match[1]} to the agent's env (a company secret) or remove the placeholder.`);
+        }
+    }
